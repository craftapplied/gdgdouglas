---
import Icon from 'astro-icon';

interface Props {
  icon: string;
  url: string;
  size?: number;
}
const { icon, url, size = 2 } = Astro.props;
---

<a href={url} target="_blank" class="text-secondary-black/80">
  <Icon
    name={icon}
    class="text-inherit"
    style={{
      width: `${size}rem`,
      height: `${size}rem`,
    }}
  />
</a>
