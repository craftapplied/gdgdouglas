---
import Icon from 'astro-icon';

const footerNavigation = [
  // { title: 'hello@gdgdouglas.com', url: 'mailto:hello@gdgdouglas.com' },
  {
    title: 'Code of Conduct',
    url: 'https://www.google.com/events/policy/anti-harassmentpolicy.html',
  },
  { title: 'Privacy Policy', url: 'https://policies.google.com/privacy' },
  { title: 'Terms of Service', url: 'https://policies.google.com/terms' },
];
---

<footer
  id="footer"
  class="grid mt-auto text-primary-white text-body-md md:pt-10 md:pb-6 xl:pt-20 xl:pb-12"
>
  <div class="container">
    {
      footerNavigation && (
        <nav class="py-6 xl:py-12" aria-label="Footer links">
          <ul class="flex justify-center align-middle gap-2 flex-wrap md:gap-4 xl:gap-8">
            {footerNavigation.map((item) => (
              <li>
                <a href={item.url} class="hover:underline">
                  {item.title}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }
    <p class="text-center flex items-center gap-1 mx-auto w-fit">
      Powered by <a
        class="hover:underline hover:opacity-75"
        href="https://craftapplied.com/"
        rel="noopener noreferrer "
        target="_blank"
      >
        <Icon name="logomark-craftapplied" class="max-w-[7rem] w-full" />
      </a>
    </p>
  </div>
</footer>
