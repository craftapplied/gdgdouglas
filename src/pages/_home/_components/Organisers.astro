---
import { Image } from 'astro:assets';
import Icon from 'astro-icon';

import organisersIllustration from '../../../images/illustration-home-organisers.png';

import memberDarrenBarklie from '../../../images/people/darren-barklie.png';
import memberHarleyGarrett from '../../../images/people/harley-garrett.png';
import memberJohnMiddleton from '../../../images/people/john-middleton.png';
import memberBransomBean from '../../../images/people/bransom-bean.png';

const organisers = [
  {
    name: 'Darren Barklie',
    company: 'Craft Applied',
    introduction:
      'Founder of Craft Applied, tech agency est. 2018, specialising in React and NextJS frontend, also working with NodeJS, NestJS, Google Cloud.',
    networks: [
      {
        brand: 'LinkedIn',
        url: 'https://linkedin.com/in/',
        icon: 'linkedin',
      },
      {
        brand: 'X',
        url: 'https://x.com/',
        icon: 'twitter',
      },
    ],
    avatar: memberDarrenBarklie,
  },
  {
    name: 'Harley Garrett',
    company: 'Craft Applied',
    introduction:
      'Founder of Craft Applied, tech agency est. 2018, specialising in React and NextJS frontend, also working with NodeJS, NestJS, Google Cloud.',
    networks: [
      {
        brand: 'LinkedIn',
        url: 'https://linkedin.com/in/',
        icon: 'linkedin',
      },
    ],
    avatar: memberHarleyGarrett,
  },
  {
    name: 'John Middleton',
    company: 'Company Name',
    introduction:
      'Founder of Craft Applied, tech agency est. 2018, specialising in React and NextJS frontend, also working with NodeJS, NestJS, Google Cloud.',
    networks: [
      {
        brand: 'LinkedIn',
        url: 'https://linkedin.com/in/',
        icon: 'linkedin',
      },
    ],
    avatar: memberJohnMiddleton,
  },
  {
    name: 'Bransom Bean',
    company: 'Fine Focus',
    introduction:
      'Founder of Craft Applied, tech agency est. 2018, specialising in React and NextJS frontend, also working with NodeJS, NestJS, Google Cloud.',
    networks: [
      {
        brand: 'LinkedIn',
        url: 'https://linkedin.com/in/',
        icon: 'linkedin',
      },
    ],
    avatar: memberBransomBean,
  },
];
---

<section id="organisers" class="home-organisers" aria-labelledby="home-organisers--heading">
  <div class="container">
    <div
      class="content-wrapper flex flex-col items-center gap-8 lg:gap-[4.5rem] rounded-8 lg:rounded-16 py-12 xl:py-24 px-6 md:px-14 xl:px-28 bg-white"
    >
      <div
        class="image-wrapper flex justify-center rounded-arch mt-12 mb-[2.563rem] max-w-[684px] w-full bg-core-green-500/[.12]"
      >
        <Image
          src={organisersIllustration}
          alt="Illustration of a folder, contains a green semicircle, blue square, yellow triangle and red square. On top of the folder is a portfolio with a pointing 3D cursor on it. On the left of portfolio is a pen."
          class="w-[68.33%] object-contain object-center -mt-12 mb-[-2.563rem]"
        />
      </div>

      <h1
        id="home-splash--heading"
        class="text-headline-lg sm:text-display-sm lg:text-display-lg font-bold text-center"
      >
        Organisers
      </h1>

      <article class="grid sm:grid-cols-2 gap-6">
        {
          organisers.map((info) => (
            <article class="flex flex-col gap-6 rounded-6 border border-neutral-200 p-6">
              <Image
                src={info.avatar}
                alt={`A small photo about an organiser, ${info.name}`}
                class="aspect-square rounded-16 w-[3.75rem]"
              />
              <hgroup class="pt-4">
                <h2 class="text-headline-sm font-bold text-primary-black">
                  {info.name}
                </h2>
                <p class="text-body-md font-regular tracking-[0.5px] text-secondary-black/80">
                  {info.company}
                </p>
              </hgroup>
              <p class="text-body-md font-regular tracking-[0.5px] text-secondary-black/80">
                {info.introduction}
              </p>
              <div class="flex gap-2">
                {info.networks.map((network) => (
                  <a
                    href={network.url}
                    target="_blank"
                    class="text-secondary-black/80"
                  >
                    <Icon
                      name={`icon-${network.icon}`}
                      class="w-8 h-8 text-inherit"
                    />
                  </a>
                ))}
              </div>
            </article>
          ))
        }
      </article>
    </div>
  </div>
</section>
