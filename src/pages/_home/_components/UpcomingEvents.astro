---
import { Image } from 'astro:assets';

import IconLink from '@component/IconLink.astro';
import { fmtIso, fmtDate, fmtDuration } from '@util/formatDatetime';
import { craftMailto, craftSearchParams } from '@util/craftUrl';
import { getEventData, getThumbnail } from '@util/getContent';

import upcomingEventsIllustration from '@image/illustration-home-upcoming-events.png';
import CtaButton from '@component/CtaButton.astro';

const event_list = await getEventData(2);
const thumbnail = getThumbnail(
  import.meta.glob('/src/images/events/*.{jpeg,jpg,png,gif}'),
  '/src/images/events'
);
---

<section
  id="upcoming-events"
  class="home-upcoming-events"
  aria-labelledby="home-upcoming-events--heading"
>
  <div
    class="container content-wrapper flex flex-col items-center gap-8 rounded-8 lg:rounded-16 py-12 xl:pt-24 md:pb-8 px-6 md:px-8 bg-white"
  >
    <div
      class="image-wrapper flex justify-center rounded-arch mt-14 mb-[1.713rem] max-w-[684px] w-full bg-core-red-500/[.12]"
    >
      <Image
        src={upcomingEventsIllustration}
        alt="Illustration of a calendar with map pin on the left and speech balloon on the right. On top of them is a check mark. Under the calendar are, form top to bottom, left to right, yellow triangle, red square, green semicircle and blue square."
        class="w-[81.43%] object-contain object-center -mt-14 mb-[-1.713rem]"
      />
    </div>

    <h1
      id="home-splash--heading"
      class="mt-10 mb-1 text-headline-lg sm:text-display-sm lg:text-display-lg font-bold text-center"
    >
      Upcoming Events
    </h1>

    {
      event_list.map((entry) => (
        <article class="grid grid-cols-1 lg:grid-cols-[auto_minmax(18rem,1fr)] lg:grid-flow-row auto-rows-max gap-7 lg:gap-8 justify-items-start rounded-8 lg:rounded-12 border-2 border-solid border-neutral-700 p-8 lg:p-12 text-primary-black">
          <p class="rounded-full px-4 bg-neutral-100">
            <span class="font-regular text-label-200 uppercase">
              {entry.type} / {entry.topic}
            </span>
          </p>
          <Image
            class="rounded-6 lg:rounded-8 max-w-[27rem]"
            src={thumbnail(entry.thumbnail)}
            alt=""
          />
          <div class="flex flex-col gap-4 py-4">
            <h2 class="font-bold text-headline-lg">{entry.title}</h2>
            <p class="font-regular text-paragraph-50">{entry.desc}</p>
          </div>
          <div class="flex gap-2">
            <CtaButton data={entry.cta} />
            {/* <a class="btn btn-outline" href="#todo">
              More details
            </a> */}
          </div>
          <aside class="shadow-popcard self-start lg:col-start-2 lg:col-span-1 lg:row-start-1 lg:row-span-4 mt-3 lg:mt-0 rounded-8 lg:rounded-12 border-2 border-solid border-neutral-700 p-8 w-full">
            <p class="font-sans font-bold text-paragraph-50">
              <time datetime={fmtIso(entry.time.start)}>
                {fmtDate(entry.time.start)}
              </time>
              {entry.time.duration < 24 ? '|' : '>'}
              {fmtDuration(entry.time.start, entry.time.duration)}
            </p>
            <a class="block mt-2 mb-8" href={entry.location[1]} target="_blank">
              {entry.location[0]}
            </a>
            <CtaButton data={entry.cta} class="btn btn-solid btn-md" />
            <div class="flex gap-2 items-center mt-4">
              <span class="mt-1.5 text-label-200 text-disabled-black">
                SHARE:
              </span>
              <IconLink
                icon="icon-facebook"
                url={`https://www.facebook.com/sharer/sharer.php?${craftSearchParams({ u: Astro.site?.origin })}`}
                size={1.5}
              />
              <IconLink
                icon="icon-linkedin"
                url={`https://www.linkedin.com/cws/share?${craftSearchParams({ url: Astro.site?.origin })}`}
                size={1.5}
              />
              <IconLink
                icon="icon-twitter"
                url={`http://x.com/share?${craftSearchParams({
                  // text: 'text goes here',
                  url: Astro.site?.origin,
                  // hashtags: ['hashtag1', 'hashtag2', 'hashtag3'],
                })}`}
                size={1.5}
              />
              <IconLink
                icon="icon-email"
                url={craftMailto(
                  'yourfriend@example.com',
                  null,
                  Astro.site?.origin
                )}
                size={1.5}
              />
            </div>
          </aside>
        </article>
      ))
    }
  </div>
</section>
