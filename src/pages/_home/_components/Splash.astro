---
import { Image } from 'astro:assets';

import splashIllustration from '../../../images/illustration-home-splash.png';
---

<section class="home-splash" aria-labelledby="home-splash--heading">
  <div class="container">
    <!-- Note(HG): Add grid gap-16 classes to content wrapper -->
    <!-- Note(HG): Will need to adjust image-wrapper:before as a result -->
    <div
      class="content-wrapper bg-white rounded-8 lg:rounded-16 py-12 xl:py-24 px-6 md:px-14 xl:px-28 grid gap-8 xl:gap-16"
    >
      <div
        class="image-wrapper relative flex justify-center align-middle w-full md:w-[fit-content] mx-auto before:content-[''] before:bg-core-blue-500 before:absolute before:inset-0 before:rounded-arch before:opacity-[0.12] px-[-0.5rem] md:before:mx-[-2.5rem] xl:before:mx-[-6rem] before:w-[calc(100% + 7.5rem)] mt-10 mb-8"
      >
        <Image
          src={splashIllustration}
          alt="Illustration of a calendar, surrounded by a blue square, green semicircle, yellow triangle and red square. In front of the calendar is a 3D outline of the Isle of Man and a rectangle containing code."
          class="max-w-[560px] w-full object-contain object-center isolate mt-[-2.5rem] mb-[-2rem] mr-[-4rem]"
        />
      </div>

      <h1
        id="home-splash--heading"
        class="text-headline-lg sm:text-display-sm lg:text-display-lg font-bold text-center"
      >
        Building Beyond Technology
      </h1>

      <div
        class="text-wrapper px-6 md:px-12 xl:px-20 grid lg:grid-cols-2 gap-x-20 gap-y-4 text-paragraph-100 md:text-paragraph-50"
      >
        <p>
          Join us at our monthly Douglas Google Developer Group events, an open
          gathering of technical professionals, amateurs, and enthusiasts from
          the Isle of Man's vibrant tech community.
        </p>
        <p>
          Discover a friendly community where contributors of all ages,
          abilities, and experience levels connect to exchange technical and
          business insights in a collaborative learning atmosphere.
        </p>
      </div>

      <a
        href="https://gdg.community.dev/gdg-douglas/"
        class="mx-auto text-button-100 md:text-button-50 bg-black px-6 py-4 rounded-full font-bold text-primary-white ring-2 ring-transparent ring-offset-2 hover:ring-black focus:ring-black focus:outline-none"
      >
        Join the community
      </a>
    </div>
  </div>
</section>
