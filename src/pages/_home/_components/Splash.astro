---
import { Image } from 'astro:assets';

import splashIllustration from '../../../images/illustration-home-splash.png';
---

<section class="home-splash" aria-labelledby="home-splash--heading">
  <div class="container">
    <!-- Note(HG): Add grid gap-16 classes to content wrapper -->
    <!-- Note(HG): Will need to adjust image-wrapper:before as a result -->
    <div class="content-wrapper bg-white rounded-16 py-24 px-28 grid gap-16">
      <div
        class="image-wrapper relative flex justify-center align-middle w-[fit-content] mx-auto before:content-[''] before:bg-core-blue-500 before:absolute before:inset-0 before:rounded-arch before:opacity-[0.12] before:mx-[-6rem] before:w-[calc(100% + 7.5rem)] mt-10 mb-8"
      >
        <Image
          src={splashIllustration}
          alt="Illustration of a calendar, surrounded by a blue square, green semicircle, yellow triangle and red square. In front of the calendar is a 3D outline of the Isle of Man and a rectangle containing code."
          class="max-w-[560px] w-full object-contain object-center isolate mt-[-2.5rem] mb-[-2rem] mr-[-4rem]"
        />
      </div>

      <h1
        id="home-splash--heading"
        class="text-display-lg font-bold text-center"
      >
        Building Beyond Technology
      </h1>

      <div
        class="text-wrapper px-20 grid grid-cols-2 gap-x-20 gap-y-4 text-paragraph-50"
      >
        <p>
          Join us at the Douglas Google Developers Event, a monthly gathering of
          technical professionals, amateurs, and enthusiasts from the vibrant
          tech community in the Isle of Man.
        </p>
        <p>
          Discover a community where industry leaders convene to exchange
          invaluable insights, fostering an environment of collaborative
          learning and knowledge sharing.
        </p>
      </div>

      <a
        href="#"
        class="mx-auto text-button-50 bg-black px-6 py-4 rounded-full font-bold text-primary-white ring-2 ring-transparent ring-offset-2 hover:ring-black focus:ring-black focus:outline-none"
      >
        Join the community</a
      >
    </div>
  </div>
</section>
