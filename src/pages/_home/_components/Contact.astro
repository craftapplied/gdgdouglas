---
import { Image } from 'astro:assets';

import Icon from 'astro-icon';

import contactIllustration from '../../../images/illustration-home-contact.png';
---

<section class="home-splash" aria-labelledby="home-splash--heading">
  <div class="container">
    <div
      class="content-wrapper bg-white rounded-8 lg:rounded-16 py-12 xl:py-24 px-6 md:px-14 xl:px-28 grid gap-8 xl:gap-16"
    >
      <div
        class="image-wrapper relative flex justify-center align-middle w-full md:w-[fit-content] mx-auto before:content-[''] before:bg-core-blue-500 before:absolute before:inset-0 before:rounded-arch before:opacity-[0.12] px-[-0.5rem] md:before:mx-[-2.5rem] xl:before:mx-[-6rem] before:w-[calc(100% + 7.5rem)] mt-10 mb-8"
      >
        <Image
          src={contactIllustration}
          alt=""
          class="max-w-[560px] w-full object-contain object-center isolate mt-[-2.5rem] mb-[-2rem] md:mr-[-4rem]"
        />
      </div>

      <h2
        id="home-splash--heading"
        class="text-headline-lg sm:text-display-sm lg:text-display-sm font-bold text-center"
      >
        Stay in the Loop
      </h2>

      <div
        class="text-wrapper px-6 md:px-12 xl:px-20 grid gap-x-20 gap-y-4 text-headline-400 md:text-headline-300 text-center max-w-[50rem] mx-auto"
      >
        <p>
          Join us at your choice of platform for a casual chat with community
          members and news of upcoming events:
        </p>
      </div>

      <ul class="grid grid-cols-3 gap-8 flex-wrap mx-auto text-center">
        <li class="grid gap-2">
          <a
            href="https://gdg.community.dev/gdg-douglas/"
            class="text-paragraph-100 md:text-paragraph-50 no-underline"
            target="_blank"
            rel="noopener noreferrer"
          >
            <figure>
              <Icon name="logomark-gdg" class="max-w-[4.5rem] w-full" />
              <figcaption>GDG</figcaption>
            </figure>
          </a>
        </li>
        <li class="grid gap-2">
          <a
            href="https://www.linkedin.com/company/gdg-douglas/"
            class="text-paragraph-100 md:text-paragraph-50 no-underline"
            target="_blank"
            rel="noopener noreferrer"
          >
            <figure>
              <Icon name="logomark-linkedin" class="max-w-[4.5rem] w-full" />
              <figcaption>LinkedIn</figcaption>
            </figure>
          </a>
        </li>
        <li class="grid gap-2">
          <!-- Meetup -->
          <a
            href="https://www.meetup.com/gdg-douglas/"
            class="text-paragraph-100 md:text-paragraph-50 no-underline"
            target="_blank"
            rel="noopener noreferrer"
          >
            <figure>
              <Icon name="logomark-meetup" class="max-w-[4.5rem] w-full" />
              <figcaption>Meetup</figcaption>
            </figure>
          </a>
        </li>
      </ul>
    </div>
  </div>
</section>
