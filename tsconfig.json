{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@image/*": [
        "src/images/*"
      ],
      "@util/*": [
        "src/utils/*"
      ],
      "@component/*": [
        "src/components/*"
      ],
    },
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
  }
}